# WalinkaRef — variables de entorno.
#
# Copia este archivo a .env y completa los valores reales (nunca commitear
# .env — ver .gitignore). Solo se listan acá las variables efectivamente
# referenciadas en el código de este proyecto (verificado por grep contra
# src/, next.config.mjs y package.json) — si alguna vez se agrega una
# variable nueva usada por el código, debe sumarse acá también.
#
# Mismo proyecto Supabase que go.ventalink.app (mismo auth.users, mismo
# Affiliate Core) — ver src/lib/supabase.ts.

# URL del proyecto Supabase (pública por diseño — protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=

# Anon key del proyecto Supabase (pública por diseño — protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
